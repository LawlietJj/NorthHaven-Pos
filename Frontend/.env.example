# Public Cloudinary cloud name (safe to expose — used in every public
# upload/delivery URL). The upload preset must be configured as "unsigned"
# on the Cloudinary dashboard.
VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"
VITE_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"

# The backend's public base URL. Vite bakes this in at build time — set it
# to the real production backend URL BEFORE running `npm run build` for
# deployment, or the deployed bundle will silently keep calling this value.
VITE_API_BASE_URL="http://localhost:4000"
