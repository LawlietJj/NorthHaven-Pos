# Used by Prisma CLI tooling during dependency installation and generation.
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/db_name"

# Required; use a unique random value of at least 32 characters.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Optional for same-origin deployment; comma-separated trusted origins if needed.
CORS_ALLOWED_ORIGINS=""

# Hostinger supplies PORT in production; this default is for local development.
PORT=5000

DB_COLLATION="UTF8MB4_GENERAL_CI"

# Optional; only needed when running the initial-owner seed script.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="replace-with-a-strong-password"

# Optional; needed for QZ Tray signing when no local private-key file exists.
# Never expose this value in a VITE_ variable.
QZ_PRIVATE_KEY=""
