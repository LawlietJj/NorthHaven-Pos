# Used by Prisma CLI tooling (migrate/generate/studio) — the running app
# itself connects via the discrete DB_* vars below through @prisma/adapter-mariadb.
DATABASE_URL="mysql://user:password@host:3306/database_name"

# Must be a strong random string, 32+ characters (server refuses to start otherwise).
JWT_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"
CORS_ALLOWED_ORIGINS=""

PORT=4000

DB_HOST="localhost"
DB_PORT=3306
DB_USER="db_user"
DB_PASSWORD="db_password"
DB_NAME="db_name"

# Only needed to run `npm run seed` (creates the initial owner account + shops).
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="replace-with-a-strong-password"
